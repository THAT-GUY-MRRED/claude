// =============================================================================
//  Renault RS27-2012  --  2.4 L 90-degree flat-plane V8 (Lotus E20, 2012 F1)
//  Script for AngeTheGreat's Engine Simulator (engine-sim, v0.1.x)
//
//  Tags used below (same legend as the spec sheet):
//    [PUB]  published by Renault
//    [REG]  mandated by the FIA 2012 technical regulations
//    [CALC] derived from published / regulated figures
//    [EST]  estimate for the era -- Renault never released it
//
//  Renault never published bore/stroke, compression, cam, valve, port, rod,
//  firing order or pipe data, so every such value here is an educated guess
//  tuned to behave like an 18,000 rpm, ~750 bhp 2.4 L V8.
// =============================================================================

import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()
label cycle(2 * 360 * units.deg)

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
    output wire5: ignition_wire();
    output wire6: ignition_wire();
    output wire7: ignition_wire();
    output wire8: ignition_wire();
}

// 4 valves/cyl, pneumatic valve springs, ~2 x 40 mm intake valves [EST]
private node rs27_head {
    input intake_camshaft;
    input exhaust_camshaft;
    // 300 cc swept / (13.5 - 1) = 24 cc -> ~13.5:1 compression [EST]
    input chamber_volume: 24 * units.cc;
    input intake_runner_volume: 180.0 * units.cc;
    input intake_runner_cross_section_area: 2.4 * units.inch * 2.4 * units.inch;
    input exhaust_runner_volume: 70.0 * units.cc;
    input exhaust_runner_cross_section_area: 1.9 * units.inch * 1.9 * units.inch;

    input flow_attenuation: 1.0;
    input lift_scale: 1.0;
    input flip_display: false;
    alias output __out: head;

    // CFM @ 28 inH2O per cylinder vs. lift in thou [EST]
    function intake_flow(50 * units.thou)
    intake_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 70 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 135 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 200 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 265 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 320 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 365 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 400 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 425 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 440 * flow_attenuation)
        .add_flow_sample(500 * lift_scale, 450 * flow_attenuation)
        .add_flow_sample(550 * lift_scale, 455 * flow_attenuation)
        .add_flow_sample(600 * lift_scale, 458 * flow_attenuation)
        .add_flow_sample(650 * lift_scale, 460 * flow_attenuation)

    function exhaust_flow(50 * units.thou)
    exhaust_flow
        .add_flow_sample(0 * lift_scale, 0 * flow_attenuation)
        .add_flow_sample(50 * lift_scale, 55 * flow_attenuation)
        .add_flow_sample(100 * lift_scale, 105 * flow_attenuation)
        .add_flow_sample(150 * lift_scale, 155 * flow_attenuation)
        .add_flow_sample(200 * lift_scale, 205 * flow_attenuation)
        .add_flow_sample(250 * lift_scale, 245 * flow_attenuation)
        .add_flow_sample(300 * lift_scale, 280 * flow_attenuation)
        .add_flow_sample(350 * lift_scale, 305 * flow_attenuation)
        .add_flow_sample(400 * lift_scale, 320 * flow_attenuation)
        .add_flow_sample(450 * lift_scale, 330 * flow_attenuation)
        .add_flow_sample(500 * lift_scale, 336 * flow_attenuation)
        .add_flow_sample(550 * lift_scale, 340 * flow_attenuation)
        .add_flow_sample(600 * lift_scale, 342 * flow_attenuation)
        .add_flow_sample(650 * lift_scale, 343 * flow_attenuation)

    generic_cylinder_head head(
        chamber_volume: chamber_volume,
        intake_runner_volume: intake_runner_volume,
        intake_runner_cross_section_area: intake_runner_cross_section_area,
        exhaust_runner_volume: exhaust_runner_volume,
        exhaust_runner_cross_section_area: exhaust_runner_cross_section_area,

        intake_port_flow: intake_flow,
        exhaust_port_flow: exhaust_flow,
        valvetrain: standard_valvetrain(
            intake_camshaft: intake_camshaft,
            exhaust_camshaft: exhaust_camshaft
        ),
        flip_display: flip_display
    )
}

// Gear-driven DOHC per bank, fixed timing (no VVT allowed) [REG]
private node rs27_camshaft {
    input lobe_profile;
    input intake_lobe_profile: lobe_profile;
    input exhaust_lobe_profile: lobe_profile;
    input lobe_separation: 105 * units.deg;
    input intake_lobe_center: lobe_separation;
    input exhaust_lobe_center: lobe_separation;
    input advance: 0 * units.deg;
    input base_radius: 0.75 * units.inch;

    output intake_cam_0: _intake_cam_0;
    output exhaust_cam_0: _exhaust_cam_0;

    output intake_cam_1: _intake_cam_1;
    output exhaust_cam_1: _exhaust_cam_1;

    camshaft_parameters params (
        advance: advance,
        base_radius: base_radius
    )

    camshaft _intake_cam_0(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam_0(params, lobe_profile: exhaust_lobe_profile)
    camshaft _intake_cam_1(params, lobe_profile: intake_lobe_profile)
    camshaft _exhaust_cam_1(params, lobe_profile: exhaust_lobe_profile)

    label rot(90 * units.deg)
    label rot360(360 * units.deg)

    // Firing order not published; standard flat-plane 1 5 3 7 4 8 2 6 [EST]
    _exhaust_cam_0
        .add_lobe(rot360 - exhaust_lobe_center + 0 * rot) // 1
        .add_lobe(rot360 - exhaust_lobe_center + 6 * rot) // 2
        .add_lobe(rot360 - exhaust_lobe_center + 2 * rot) // 3
        .add_lobe(rot360 - exhaust_lobe_center + 4 * rot) // 4
    _intake_cam_0
        .add_lobe(rot360 + intake_lobe_center + 0 * rot) // 1
        .add_lobe(rot360 + intake_lobe_center + 6 * rot) // 2
        .add_lobe(rot360 + intake_lobe_center + 2 * rot) // 3
        .add_lobe(rot360 + intake_lobe_center + 4 * rot) // 4

    _exhaust_cam_1
        .add_lobe(rot360 - exhaust_lobe_center + 1 * rot) // 5
        .add_lobe(rot360 - exhaust_lobe_center + 7 * rot) // 6
        .add_lobe(rot360 - exhaust_lobe_center + 3 * rot) // 7
        .add_lobe(rot360 - exhaust_lobe_center + 5 * rot) // 8
    _intake_cam_1
        .add_lobe(rot360 + intake_lobe_center + 1 * rot) // 5
        .add_lobe(rot360 + intake_lobe_center + 7 * rot) // 6
        .add_lobe(rot360 + intake_lobe_center + 3 * rot) // 7
        .add_lobe(rot360 + intake_lobe_center + 5 * rot) // 8
}

private node turbulence_to_flame_speed_ratio {
    alias output __out:
        function(5.0)
            .add_sample(0.0, 3.0)
            .add_sample(5.0, 1.5 * 5.0)
            .add_sample(10.0, 1.75 * 10.0)
            .add_sample(15.0, 2.0 * 15.0)
            .add_sample(20.0, 2.0 * 20.0)
            .add_sample(25.0, 2.0 * 25.0)
            .add_sample(30.0, 2.0 * 30.0)
            .add_sample(35.0, 2.0 * 35.0)
            .add_sample(40.0, 2.0 * 40.0)
            .add_sample(45.0, 2.0 * 45.0)
            .add_sample(60.0, 2.0 * 60.0)
            .add_sample(80.0, 2.0 * 80.0);
}

public node renault_rs27_2012 {
    alias output __out: engine;

    engine engine(
        name: "Renault RS27-2012 V8",
        starter_torque: 60 * units.lb_ft,
        starter_speed: 1500 * units.rpm,
        redline: 18000 * units.rpm,              // FIA limit [REG]
        throttle_gamma: 2.0,
        fuel: fuel(
            max_burning_efficiency: 1.0,
            turbulence_to_flame_speed_ratio: turbulence_to_flame_speed_ratio()
        ),
        hf_gain: 0.01,
        noise: 1.0,
        jitter: 0.1,
        // 18,000 rpm = 300 rev/s. Keep this high or the sim gets coarse /
        // unstable at the limiter. Lower it if your PC can't keep up.
        simulation_frequency: 24000
    )

    wires wires()

    label bore(98 * units.mm)                    // max bore [REG]
    label stroke(39.8 * units.mm)                // 2400 cc / 8 at 98 mm bore [CALC]
    label rod_length(100 * units.mm)             // [EST]
    label rod_mass(300 * units.g)                // titanium, one piece [EST]
    label piston_mass(250 * units.g)             // [PUB]
    label compression_height(14 * units.mm)      // [EST]
    label crank_mass(6 * units.kg)               // [EST]
    label flywheel_mass(1.5 * units.kg)          // carbon clutch pack, no flywheel [EST]
    label flywheel_radius(50 * units.mm)         // [EST]

    label crank_moment(
        1.5 * disk_moment_of_inertia(mass: crank_mass, radius: stroke)
    )
    label flywheel_moment(
        disk_moment_of_inertia(mass: flywheel_mass, radius: flywheel_radius)
    )
    label other_moment( // gear train, cams, pumps, KERS rotor [EST]
        disk_moment_of_inertia(mass: 2 * units.kg, radius: 3.0 * units.cm)
    )

    label v_angle(90 * units.deg)                // [PUB/REG]
    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: flywheel_mass,
        mass: crank_mass,
        friction_torque: 12.0 * units.lb_ft,
        moment_of_inertia:
            crank_moment + flywheel_moment + other_moment,
        position_x: 0.0,
        position_y: 0.0,
        tdc: 90 * units.deg + (v_angle / 2.0)
    )

    // Flat-plane (180 deg) crank [EST]
    rod_journal rj0(angle: 0 * units.deg)
    rod_journal rj1(angle: 180 * units.deg)
    rod_journal rj2(angle: 180 * units.deg)
    rod_journal rj3(angle: 0 * units.deg)
    c0
        .add_rod_journal(rj0)
        .add_rod_journal(rj1)
        .add_rod_journal(rj2)
        .add_rod_journal(rj3)

    piston_parameters piston_params(
        mass: piston_mass,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: rod_mass,
        moment_of_inertia: rod_moment_of_inertia(
            mass: rod_mass,
            length: rod_length
        ),
        center_of_mass: 0.0,
        length: rod_length
    )

    // Airbox + fixed-length trumpets, 8 individual throttles [PUB/REG]
    intake intake(
        plenum_volume: 6.0 * units.L,
        plenum_cross_section_area: 150.0 * units.cm2,
        intake_flow_rate: k_carb(1600.0),
        runner_flow_rate: k_carb(350.0),
        runner_length: 7.0 * units.inch,
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.985,
        velocity_decay: 0.5
    )

    // Equal-length primaries into one tailpipe per bank (max 2 exits) [REG]
    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(1400.0),
        primary_tube_length: 24.0 * units.inch,
        primary_flow_rate: k_carb(500.0),
        velocity_decay: 0.5
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 0.2,
        length: 30 * units.inch,
        impulse_response: ir_lib.mild_exhaust_0_reverb
    )
    exhaust_system exhaust1(
        es_params,
        audio_volume: 0.19,
        length: 30 * units.inch,
        impulse_response: ir_lib.mild_exhaust_0_reverb
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )

    cylinder_bank b0(bank_params, angle: v_angle / 2.0)
    cylinder_bank b1(bank_params, angle: -v_angle / 2.0)
    b0
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.0)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire1,
            sound_attenuation: 1.0,
            primary_length: 0 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.0)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire2,
            sound_attenuation: 0.95,
            primary_length: 0.5 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.0)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire3,
            sound_attenuation: 1.0,
            primary_length: 1 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.0)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust0,
            ignition_wire: wires.wire4,
            sound_attenuation: 0.95,
            primary_length: 0.5 * units.cm
        )
        .set_cylinder_head(
            rs27_head(
                intake_camshaft: camshaft.intake_cam_0,
                exhaust_camshaft: camshaft.exhaust_cam_0,
                flip_display: true)
        )
    b1
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.0)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire5,
            sound_attenuation: 1.0,
            primary_length: 0.5 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.0)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire6,
            sound_attenuation: 0.95,
            primary_length: 0 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.0)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj2,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire7,
            sound_attenuation: 1.0,
            primary_length: 1 * units.cm
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.0)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj3,
            intake: intake,
            exhaust_system: exhaust1,
            ignition_wire: wires.wire8,
            sound_attenuation: 0.95,
            primary_length: 0.5 * units.cm
        )
        .set_cylinder_head(
            rs27_head(
                intake_camshaft: camshaft.intake_cam_1,
                exhaust_camshaft: camshaft.exhaust_cam_1)
        )

    engine
        .add_cylinder_bank(b0)
        .add_cylinder_bank(b1)

    engine.add_crankshaft(c0)

    // ~15-16 mm lift, very long duration, big overlap [EST]
    harmonic_cam_lobe intake_lobe(
        duration_at_50_thou: 275 * units.deg,
        gamma: 0.8,
        lift: 620 * units.thou,
        steps: 256
    )

    harmonic_cam_lobe exhaust_lobe(
        duration_at_50_thou: 265 * units.deg,
        gamma: 0.8,
        lift: 580 * units.thou,
        steps: 256
    )

    rs27_camshaft camshaft(
        lobe_profile: "N/A",

        intake_lobe_profile: intake_lobe,
        exhaust_lobe_profile: exhaust_lobe,
        intake_lobe_center: 104 * units.deg,
        exhaust_lobe_center: 106 * units.deg,
        base_radius: 0.75 * units.inch
    )

    // Ignition advance [EST]
    function timing_curve(2000 * units.rpm)
    timing_curve
        .add_sample(0 * units.rpm, 10 * units.deg)
        .add_sample(2000 * units.rpm, 12 * units.deg)
        .add_sample(4000 * units.rpm, 18 * units.deg)
        .add_sample(6000 * units.rpm, 24 * units.deg)
        .add_sample(8000 * units.rpm, 30 * units.deg)
        .add_sample(10000 * units.rpm, 34 * units.deg)
        .add_sample(12000 * units.rpm, 36 * units.deg)
        .add_sample(14000 * units.rpm, 38 * units.deg)
        .add_sample(16000 * units.rpm, 38 * units.deg)
        .add_sample(18000 * units.rpm, 38 * units.deg)
        .add_sample(20000 * units.rpm, 38 * units.deg)

    ignition_module ignition_module(
        timing_curve: timing_curve,
        rev_limit: 18000 * units.rpm,            // FIA limit [REG]
        limiter_duration: 0.05)
    ignition_module
            .connect_wire(wires.wire1,  0 * 90 * units.deg)
            .connect_wire(wires.wire5,  1 * 90 * units.deg)
            .connect_wire(wires.wire3,  2 * 90 * units.deg)
            .connect_wire(wires.wire7,  3 * 90 * units.deg)
            .connect_wire(wires.wire4,  4 * 90 * units.deg)
            .connect_wire(wires.wire8,  5 * 90 * units.deg)
            .connect_wire(wires.wire2,  6 * 90 * units.deg)
            .connect_wire(wires.wire6,  7 * 90 * units.deg)

    engine.add_ignition_module(ignition_module)
}

// Lotus E20: 640 kg minimum incl. driver [REG]. Downforce isn't modelled,
// so drag is a rough CdA of ~1.3 m^2 [EST].
private node lotus_e20_vehicle {
    alias output __out:
        vehicle(
            mass: 640 * units.kg,
            drag_coefficient: 0.9,
            cross_sectional_area: 1.45 * units.m * 1.0 * units.m,
            diff_ratio: 3.5,
            tire_radius: 330 * units.mm,
            rolling_resistance: 250 * units.N
        );
}

// 7-speed seamless-shift gearbox [REG]; ratios give ~320 km/h at 18,000 rpm
// in 7th [EST]
private node lotus_e20_transmission {
    alias output __out:
        transmission(
            max_clutch_torque: 350 * units.lb_ft
        )
        .add_gear(5.80)
        .add_gear(4.40)
        .add_gear(3.55)
        .add_gear(2.95)
        .add_gear(2.55)
        .add_gear(2.25)
        .add_gear(2.00);
}

public node main {
    set_engine(renault_rs27_2012())
    set_vehicle(lotus_e20_vehicle())
    set_transmission(lotus_e20_transmission())
}
